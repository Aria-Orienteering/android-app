<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app data for cloud backup -->
        <include domain="file" path="." />
    </cloud-backup>

    <device-transfer>
        <!-- Data to include in device-to-device transfer -->
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
