## This file contains local configuration for your development environment.
## Copy this file to 'local.properties' and fill in your actual values.
## DO NOT commit local.properties to version control!

## Android SDK location (auto-generated by Android Studio)
## Uncomment and set if needed:
# sdk.dir=/path/to/Android/sdk

## Firebase Configuration
## Get these from Firebase Console -> Project Settings -> General
FirebaseWebClientKey=YOUR_FIREBASE_WEB_CLIENT_KEY_HERE
FirebaseWebClientSecretKey=YOUR_FIREBASE_WEB_CLIENT_SECRET_HERE

## Google Maps API Key
## Get this from Google Cloud Console -> APIs & Services -> Credentials
GoogleMapApiKey=YOUR_GOOGLE_MAPS_API_KEY_HERE
